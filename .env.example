# Copie este arquivo para .env (localmente) ou configure
# essas mesmas variáveis direto no painel do Railway.

# String que você mesmo inventa (qualquer texto). Vai usar
# o MESMO valor no painel do Meta ao configurar o webhook.
VERIFY_TOKEN=escolha_uma_senha_aqui

# Token que você gerou na tela "Gerar tokens de acesso"
PAGE_ACCESS_TOKEN=cole_o_token_aqui

# Sua chave da API do Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=cole_sua_chave_aqui
